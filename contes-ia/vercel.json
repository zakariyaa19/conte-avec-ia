{
  "redirects": [
    {
      "source": "/blog/livre-personnalise-enfant-2026",
      "destination": "/blog/guide-livre-personnalise-enfant-2026",
      "statusCode": 301
    },
    {
      "source": "/blog/conte-personnalise-confiance-imagination-enfant",
      "destination": "/blog/enfant-heros-propre-histoire",
      "statusCode": 301
    },
    {
      "source": "/blog/intelligence-artificielle-histoires-enfants",
      "destination": "/blog/ia-revolution-creation-histoires-enfants",
      "statusCode": 301
    },
    {
      "source": "/blog/bienfaits-lecture-personnalisee-enfant",
      "destination": "/blog/enfant-heros-propre-histoire",
      "statusCode": 301
    },
    {
      "source": "/blog/conte-personnalise-rituel-coucher",
      "destination": "/blog/conte-pour-sendormir-histoires-personnalisees",
      "statusCode": 301
    },
    {
      "source": "/blog/creation-histoires-personnalisees-conte-ia",
      "destination": "/blog/ia-revolution-creation-histoires-enfants",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
