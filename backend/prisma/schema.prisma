// Schema Prisma pour l'application Contes d'IA
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  password  String?
  googleId  String?  @unique
  role      UserRole @default(USER)

  // Stripe / Abonnement
  stripeCustomerId      String?
  subscriptionId        String?
  subscriptionStatus    String?
  subscriptionPeriodEnd DateTime?

  // Compteur soumissions Club (reset hebdomadaire lazy)
  weeklySubmissionCount Int       @default(0)
  weeklySubmissionReset DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders        Order[]
  childProfiles ChildProfile[]

  @@map("users")
}

model ChildProfile {
  id       String  @id @default(cuid())
  userId   String
  name     String
  age      Int?
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@map("child_profiles")
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  status    OrderStatus @default(PENDING)

  // Etape 1 - Donnees du conte
  ageRange           String
  generalTheme       String
  customTheme        String?
  specificSubject    String
  customSubject      String?
  centralMessage     String
  customMessage      String?
  illustrationStyle  String

  // Etape 2 - Donnees du protagoniste
  protagonistName    String
  protagonistAge     String?
  protagonistGender  String?
  eyeColor          String?
  hairColor         String?
  skinColor         String?
  photoUrl          String?
  coverImageUrl     String?
  coverImageData    Bytes?
  coverTitle        String?

  // Langue du conte
  language          String?

  // Informations supplementaires (facultatif)
  hobbies           String?
  favoriteDish      String?
  specialEvents     String?

  // Option religieuse (facultatif)
  religion          String?
  customReligion    String?

  // Personnages secondaires (jusqu'a 5) - stockes en JSON
  secondaryCharactersJson String?

  // Anciens champs personnage secondaire (retrocompatibilite)
  secondaryCharacterName String?
  secondaryCharacterAge  String?

  // Details personnels
  creatorName       String?
  narratedBy        String?

  // Informations produit
  productType       ProductType
  purchaseType      PurchaseType @default(SINGLE)
  price            Decimal

  // Adresse de livraison (optionnelle pour eBook)
  shippingFirstName String?
  shippingLastName  String?
  shippingAddress   String?
  shippingCity      String?
  shippingPostalCode String?

  // Paiement
  stripePaymentIntentId String?
  paidAt               DateTime?

  // Fichiers generes / livraison
  ebookUrl            String?
  pdfUrl              String?
  pdfData             Bytes?
  epubUrl             String?
  generatedAt         DateTime?
  storyStatus         StoryStatus @default(EN_COURS)
  deliveredAt         DateTime?

  // Preview data (reused in full generation)
  firstIllustrationUrl   String?
  storyPreviewTextJson   String?

  // Generation automatique
  generationProgress   Int?
  generationError      String?
  generationStartedAt  DateTime?
  storyTextJson        String?
  isTestOrder          Boolean    @default(false)

  // URLs des illustrations individuelles (JSON array pour partage public)
  illustrationUrlsJson String?

  // Séquence email relance (post-livre gratuit)
  emailSequenceSent   String?

  // Favoris et profil enfant
  isFavorite          Boolean @default(false)
  shareToken          String?  @unique
  childProfileId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user            User?            @relation(fields: [userId], references: [id])
  childProfile    ChildProfile?    @relation(fields: [childProfileId], references: [id])
  generationLogs  GenerationLog[]

  @@map("orders")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      AdminRole @default(ADMIN)
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model GenerationLog {
  id          String    @id @default(cuid())
  orderId     String
  attempt     Int       @default(1)
  status      String    // 'started' | 'completed' | 'failed'
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?
  stepsJson   String?   // JSON: [{step, status, timestamp, detail}]
  pdfUrl      String?
  source      String    @default("generation") // 'generation' | 'manual_upload'
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("generation_logs")
}

enum UserRole {
  USER
  CLUB
  ADMIN
}

enum OrderStatus {
  PENDING
  UNPAID
  PAID
  GENERATING
  GENERATED
  BLOCKED
  DELIVERED
}

enum ProductType {
  EBOOK
  PRINTED
}

enum PurchaseType {
  SINGLE
  CLUB
}

enum StoryStatus {
  EN_COURS
  GENERATING_TEXT
  GENERATING_IMAGES
  ASSEMBLING_PDF
  DISPONIBLE
  GENERATION_FAILED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}
