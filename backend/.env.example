# ============================================
# BACKEND — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env avec des valeurs reelles
# ============================================

# --- Base de donnees ---
# Dev (SQLite) : file:./dev.db
# Prod (PostgreSQL) : postgresql://user:password@host:5432/contes_ia_db
DATABASE_URL=

# --- URLs / Ports ---
PORT=5001
NODE_ENV=development
FRONTEND_URL=
BACKEND_URL=

# --- CORS (origines supplementaires, separees par des virgules) ---
CORS_ALLOWED_ORIGINS=

# --- Auth (JWT) ---
JWT_SECRET=
JWT_CLIENT_SECRET=
JWT_EXPIRES_IN=24h
BOOTSTRAP_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLUB_PRICE_ID=
STRIPE_CLUB_MONTHLY_PRICE_ID=
STRIPE_CLUB_ANNUAL_PRICE_ID=

# --- Mailjet ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
ADMIN_EMAIL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- TikTok Events API (optionnel) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=

# --- OpenAI (Cover Preview IA) ---
OPENAI_API_KEY=

# --- Upload ---
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
